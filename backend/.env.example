# Copy this file to .env and fill in real values
# Never commit .env to version control

PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/live_loop?appName=live_loop

JWT_ACCESS_SECRET=<at-least-64-char-random-hex>
JWT_REFRESH_SECRET=<at-least-64-char-random-hex>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# LiveKit Video Cloud/Server Configuration
LIVEKIT_URL=wss://live-loop-wdcidnza.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

